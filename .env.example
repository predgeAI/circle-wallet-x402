# Copy to .env (it is gitignored) and fill in. Variables already set in the environment win.

# --- Circle ------------------------------------------------------------------
# console.circle.com -> API & Client Keys. A TEST key works on BASE-SEPOLIA and ARC-TESTNET.
# Paying a mainnet paywall needs a LIVE key, and a LIVE key only works once Mainnet account
# setup is complete in the console, billing details included (until then wallet calls return 403).
CIRCLE_API_KEY=

# 32 bytes of hex. Leave empty and run `node circle-x402.mjs setup`: it generates one,
# registers it with Circle and writes it here.
CIRCLE_ENTITY_SECRET=

# Written by `create-wallet`. For another chain, `derive <CHAIN>` prints a wallet id with the same address.
CIRCLE_WALLET_ID=

# Chain for `create-wallet` when none is given: BASE, BASE-SEPOLIA, ARC or ARC-TESTNET.
CIRCLE_BLOCKCHAIN=BASE

# Where `setup` saves Circle's recovery file. Default: .circle-recovery/ next to this script.
CIRCLE_RECOVERY_DIR=

# --- The paywall ---------------------------------------------------------------
# Any x402 v2 resource. Can also be given on the command line: node circle-x402.mjs pay <url>
X402_URL=

# Request method and body, for paid POST routes. GET with no body by default.
X402_METHOD=GET
X402_BODY=
X402_CONTENT_TYPE=application/json

# --- Guards ---------------------------------------------------------------------
# Never pay more than this many atomic units per call. USDC has 6 decimals: 10000 = 0.01 USDC.
X402_MAX_AMOUNT=10000

# Optional: refuse to pay unless the 402 names exactly this payee.
X402_EXPECT_PAY_TO=

# Optional: the network to pay on, as CAIP-2 (eip155:8453 Base, eip155:5042 Arc).
# Defaults to the wallet's own chain, which is the only chain Circle will sign for.
X402_PAY_NETWORK=
